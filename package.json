{
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^8.0.3"
  },
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm run backend\" \"npm run frontend\"",
    "backend": "cd Backend && npm run dev",
    "frontend": "cd Frontend && npm run dev",
    "ollama:start": "ollama serve",
    "ollama:stop": "pkill ollama || true"
  }
}
